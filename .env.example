APP_NAME=APISense
APP_ENV=development
SECRET_KEY=your-secret-key

DATABASE_URL=postgresql+asyncpg://username:password@host/database

# Optional SQLAlchemy pool tuning (defaults shown)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=300
DB_POOL_PRE_PING=true
DB_ECHO=false

# JWT
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# Brevo transactional email (https://api.brevo.com/v3/smtp/email)
BREVO_API_KEY=your-brevo-api-key
EMAIL_FROM=noreply@example.com
EMAIL_FROM_NAME=APISense
APP_BASE_URL=http://localhost:8000

# Optional: verification link expiry (default shown)
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24

# Optional: password reset link expiry in minutes (default shown)
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
